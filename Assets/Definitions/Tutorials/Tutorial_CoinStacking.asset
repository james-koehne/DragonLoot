  prerequisiteTutorialIds: []
  steps:
  - body: Drop matching coins onto each other to build a stack.
    keybindHint: '[{SecondaryInteract}] Place on coin'
  - body: Hold the stack pickup control to lift an entire stack at once.
    keybindHint: '[{WholeStackPickup}] Whole stack'
  - body: Hold the stack place control to set a whole stack back down.
    keybindHint: '[{WholeStackPlace}] Place stack'

  id: quest_starting
  displayTitle: Clear the Way
  onStartDialogue:
  - speaker: Dragon
    text: Ah. Welcome, little Hoardkeeper.
    pauseAfter: 2
    sfx: {fileID: 8300000, guid: 1500440cf0c3c744ab95f203dbed073a, type: 3}
    sfxVol: 0.5
  - speaker: Dragon
    text: My hoard has grown somewhat... unwieldy.
    pauseAfter: 2
    sfx: {fileID: 8300000, guid: 7a7c1a177462ce6479a797508c17e5ca, type: 3}
    sfxVol: 0.5
  onCompleteDialogue:
  - speaker: Dragon
    text: That is much better.
    pauseAfter: 2
    sfx: {fileID: 8300000, guid: edcb23291bd8d9949bbdeea2451b8043, type: 3}
    sfxVol: 0.5
  - speaker: Dragon
    text: I will now unlock the door.
    pauseAfter: 2
    sfx: {fileID: 8300000, guid: 7a7c1a177462ce6479a797508c17e5ca, type: 3}
    sfxVol: 0.5

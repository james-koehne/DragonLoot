%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27725a0549f518041a754948f828997a, type: 3}
  m_Name: Quest_Starting
  m_EditorClassIdentifier: Assembly-CSharp::QuestDefinition
  id: quest_starting
  displayTitle: Clear the Way
  onStartDialogue:
  - speaker: Dragon
    text: Ah. There you are, little Hoardkeeper.
    pauseAfter: 0.25
    sfx: {fileID: 8300000, guid: f13adbb4656cc064083454976bf75b28, type: 3}
    sfxVol: 0.5
  - speaker: Dragon
    text: I have been... busy.
    pauseAfter: 0.6
    sfx: {fileID: 8300000, guid: 2e550f1b77600864197bcd1410237943, type: 3}
    sfxVol: 0.5
  onCompleteDialogue:
  - speaker: Dragon
    text: Now, Hoardkeeper...
    pauseAfter: 0.25
    sfx: {fileID: 8300000, guid: 466dd3dd2508c3447a4f704570c2ae91, type: 3}
    sfxVol: 0.5
  - speaker: Dragon
    text: I believe we have rather a lot of work to do.
    pauseAfter: 0.4
    sfx: {fileID: 8300000, guid: edcb23291bd8d9949bbdeea2451b8043, type: 3}
    sfxVol: 0.5
  steps:
  - id: view_doorway_gold
    objectiveText: Look toward the gold blocking the doorway
    markerTargetId: volume_doorway_gold
    onEnterDialogue: []
    onCompleteDialogue:
    - speaker: Dragon
      text: Oh.
      pauseAfter: 0.25
      sfx: {fileID: 8300000, guid: 466dd3dd2508c3447a4f704570c2ae91, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: My hoard has grown somewhat... unwieldy.
      pauseAfter: 0.25
      sfx: {fileID: 8300000, guid: cbc4534d57c0c6643bd64230f0e78b81, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: You'll need to dig your way out...
      pauseAfter: 0.5
      sfx: {fileID: 8300000, guid: 466dd3dd2508c3447a4f704570c2ae91, type: 3}
      sfxVol: 0.5
    conditionMode: 0
    conditions:
    - type: 0
      targetId: volume_doorway_gold
      requiredCount: 1
      requiredTreasure: {fileID: 0}
      sectionId: 
  - id: clear_and_sort
    objectiveText: Clear the doorway pile and place the loot on the sorting plinth
    markerTargetId: starting_door_pile
    onEnterDialogue: []
    onCompleteDialogue: []
    conditionMode: 0
    conditions:
    - type: 1
      targetId: starting_door_pile
      requiredCount: 1
      requiredTreasure: {fileID: 0}
      sectionId: 
    - type: 2
      targetId: starting_sorting_plinth
      requiredCount: 5
      requiredTreasure: {fileID: 0}
      sectionId: 

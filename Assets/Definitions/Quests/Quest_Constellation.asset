  id: quest_constellation
  displayTitle: Admire the Gems
  onStartDialogue:
  - speaker: Dragon
    text: Gold is for counting.
    pauseAfter: 0.25
  - speaker: Dragon
    text: Gems, however...
    pauseAfter: 0.25
  - speaker: Dragon
    text: ...are for admiring.
    pauseAfter: 0.5
  onCompleteDialogue:
  - speaker: Dragon
    text: I haven't seen that in a very long time.
    pauseAfter: 1.2
  - speaker: Dragon
    text: Beautiful.
    pauseAfter: 0.6
  steps:
  - id: find_constellation
    objectiveText: Find the constellation wall
    markerTargetId: constellation
    onEnterDialogue: []
    onCompleteDialogue: []
    conditionMode: 0

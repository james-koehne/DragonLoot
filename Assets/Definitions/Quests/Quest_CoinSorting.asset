  m_Script: {fileID: 11500000, guid: 27725a0549f518041a754948f828997a, type: 3}
  m_Name: Quest_CoinSorting
  m_EditorClassIdentifier: Assembly-CSharp::QuestDefinition
  id: quest_coin_sorting
  displayTitle: Sort the Gold
  onStartDialogue:
  - speaker: Dragon
    text: Gold is rather easier to appreciate when it isn't scattered across the
      floor.
    pauseAfter: 0.4
  onCompleteDialogue:
  - speaker: Dragon
    text: Much better. A respectable hoard should be sorted.
    pauseAfter: 0.4
  steps:
  - id: find_sorter
    objectiveText: Find the coin sorter
    markerTargetId: coin_sorter
    onEnterDialogue: []
    onCompleteDialogue: []
    conditionMode: 0
    conditions:
    - type: 0
      targetId: volume_coin_sorter
      requiredCount: 1
      requiredTreasure: {fileID: 0}
      sectionId: 
  - id: use_sorter
    objectiveText: Use the coin sorter
    markerTargetId: coin_sorter
    onEnterDialogue: []
    onCompleteDialogue:
    - speaker: Dragon
      text: That is considerably faster than your manual sorting.
      pauseAfter: 0.4
    conditionMode: 0
    conditions:
    - type: 3
      targetId: coin_sorter
      requiredCount: 1
      requiredTreasure: {fileID: 0}
      sectionId: 
  - id: fill_coin_plinth
    objectiveText: Bring sorted stacks to the coin plinths
    markerTargetId: coin_plinth
    onEnterDialogue: []
    onCompleteDialogue: []
    conditionMode: 0
    conditions:
    - type: 6
      targetId: coin_plinth
      requiredCount: 1
      requiredTreasure: {fileID: 0}

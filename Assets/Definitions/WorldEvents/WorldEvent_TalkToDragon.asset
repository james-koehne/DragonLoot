  - type: 8
    delayBefore: 0
    onlyDelayThisAction: 0
    waitUntilFinished: 1
    dialogue:
    - speaker: Dragon
      text: Ah. You've found me at last, little Hoardkeeper.
      pauseAfter: 0
      sfx: {fileID: 8300000, guid: c7e351ef36d20aa4bbde63d18e45e05f, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: I've spent a lifetime collecting this treasure. I'm ready to retire.
      pauseAfter: 0
      sfx: {fileID: 8300000, guid: c7e351ef36d20aa4bbde63d18e45e05f, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: "Unfortunately, the hoard has become\u2026 completely disorganized."
      pauseAfter: 0
      sfx: {fileID: 8300000, guid: c7e351ef36d20aa4bbde63d18e45e05f, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: I need someone to take care of it. That someone is you.
      pauseAfter: 0
      sfx: {fileID: 8300000, guid: c7e351ef36d20aa4bbde63d18e45e05f, type: 3}
      sfxVol: 0.5
    - speaker: Dragon
      text: 'Your first task: get the Workshop operational. Clear the entrance, then
        clear out the mess inside.'
      pauseAfter: 0
      sfx: {fileID: 8300000, guid: c7e351ef36d20aa4bbde63d18e45e05f, type: 3}
      sfxVol: 0.5
